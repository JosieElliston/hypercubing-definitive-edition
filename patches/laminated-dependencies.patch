+#[cfg(test)]
+mod camera_tests {
+    use super::*;
+
+    #[test]
+    fn stationary_pointer_preserves_the_rotated_camera() {
+        let mut camera = CameraFacing {
+            position: Vec3::new(5.0, -10.0, 4.0),
+            target: Vec3::new(0.0, 0.0, 0.0),
+            up: Vec3::new(0.0, 0.0, 1.0),
+        };
+
+        camera.orbit((24.0, -12.0));
+        let rotated = (camera.position, camera.target, camera.up);
+        camera.orbit((0.0, 0.0));
+
+        assert_eq!((camera.position, camera.target, camera.up), rotated);
+    }
+}
