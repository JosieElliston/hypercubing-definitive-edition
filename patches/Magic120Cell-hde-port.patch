+// Line-based text file I/O matching what the original System::IO code did:
+// lines are written with CRLF, and read lines may end in CRLF, LF or CR.
+class CLineReader
+{
+public:
+
+	bool open( const wchar_t * fileName )
+	{
+		FILE * f = _wfopen( fileName, L"rb" );
+		if( !f )
+			return false;
+		char buf[4096];
+		size_t n;
+		while( ( n = fread( buf, 1, sizeof( buf ), f ) ) > 0 )
+			m_data.append( buf, n );
+		fclose( f );
+
+		// Skip a UTF-8 byte order mark, as StreamReader does.
+		if( 0 == m_data.compare( 0, 3, "\xEF\xBB\xBF" ) )
+			m_pos = 3;
+		return true;
+	}
+
+	// Like StreamReader::Peek() >= 0.
+	bool more() const { return m_pos < m_data.size(); }
+
+	std::string readLine()
+	{
+		size_t end = m_data.find_first_of( "\r\n", m_pos );
+		if( std::string::npos == end )
+			end = m_data.size();
+		std::string line = m_data.substr( m_pos, end - m_pos );
+		m_pos = end;
+		if( m_pos < m_data.size() && '\r' == m_data[m_pos] )
+			m_pos++;
+		if( m_pos < m_data.size() && '\n' == m_data[m_pos] )
+			m_pos++;
+		return line;
+	}
+
+private:
+
+	std::string m_data;
+	size_t m_pos = 0;
+};
+
+// Like String::Split with a tab delimiter.
+std::vector<std::string> 
+split( const std::string & line ) 
+{
+	std::vector<std::string> result;
+	size_t start = 0, tab;
+	while( std::string::npos != ( tab = line.find( '\t', start ) ) )
+	{
+		result.push_back( line.substr( start, tab - start ) );
+		start = tab + 1;
+	}
+	result.push_back( line.substr( start ) );
+	return result;
+}
+
+// Like System::Convert::ToInt32, but returns false instead of throwing.
+bool 
+toInt( const std::string & s, int & value, int base = 10 ) 
+{
+	const char * begin = s.c_str();
+	char * end;
+	long l = strtol( begin, &end, base );
+	if( 10 == base )
+		while( ' ' == *end || '\t' == *end )
+			end++;
+	if( end == begin || '\0' != *end )
+		return false;
+	value = (int)l;
+	return true;
+}
