+	/// This was the C++/CLI CubeFrame class; it moved here so no part of the program is mixed-mode.
+	/// </summary>
+	public class CubeFrame : ICube
+	{
+		// The main frame of our UI
+		private MainFrame m_frame;
+
+		// Additonal managed component bits.
+		private IContainer m_components;
+		private Timer m_timer;
+
+		// The puzzle and its renderer.
+		private IntPtr m_core;
+		private bool m_enableRedraw = true;
+
+		// Whether or not we are solving.
