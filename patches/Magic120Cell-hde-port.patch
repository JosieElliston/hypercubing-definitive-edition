+		private int m_mouseDownY = -1;
+		private bool m_dragging;
+		private int m_mouseLastX;
+		private int m_mouseLastY;
+
+		// The last filename we saved or loaded.
+		private string m_filename = "";
+
+		// run the application
+		public void Run()
+		{
+			m_frame = new MainFrame( this );
+
+			m_components = new Container();
+			m_timer = new Timer( m_components );
+			m_timer.Interval = 20;
+			m_timer.Tick += TimerTick;
+
+			m_frame.Load += FrameLoad;
+
+			m_frame.DrawSurface.Paint += Paint;
+			m_frame.DrawSurface.KeyDown += KeyDown;
+			m_frame.DrawSurface.MouseDown += MouseDown;
+			m_frame.DrawSurface.MouseMove += MouseMove;
+			m_frame.DrawSurface.MouseUp += MouseUp;
+
+			m_core = Core.M120C_Create();
+
+			Application.Run( m_frame );
+
+			m_components.Dispose();
+			Core.M120C_Destroy( m_core );
+		}
+
+		private void FrameLoad( object sender, EventArgs args )
+		{
+			Core.M120C_InitGL( m_frame.DrawSurface.Handle );
+		}
+
+		private void Paint( object sender, PaintEventArgs args )
+		{
+			DoRender( args.Graphics );
+		}
+
+		private void TimerTick( object sender, EventArgs e )
+		{
+			if( m_currentAngle + Core.M120C_GetCurrentTwistStep( m_core ) >= Core.M120C_GetCurrentTwistEndAngle( m_core ) )
+			{
+				Core.M120C_FinishRotate( m_core );
+				DoRender();
+				bool showMessage = false;
+
+				// Special handling if we are solving.
+				if( m_solving )
+				{
+					// Start the next undo.
+					if( 0 != Core.M120C_StartUndo( m_core ) )
+					{
+						RotationStarted();
+						return;
+					}
+					else
+					{
+						m_solving = false;
+					}
+				}
+				else
+				{
+					int solved = Core.M120C_CheckSolved( m_core );
+					if( 0 != solved )
+					{
+						// Beep!
+						System.Media.SystemSounds.Asterisk.Play();
+
+						// See if we should show a message.
+						showMessage = 3 == solved;
+					}
+				}
+
+				m_timer.Enabled = false;
+				m_animating = false;
+
+				Redraw( false );
+
+				// Show a congratulatory message if they've solved it.
+				if( showMessage )
+					ShowSolvedMessage();
+
+				return;
+			}
+
+			// Do the drawing.
+			Core.M120C_IterateRotate( m_core );
+			DoRender();
+
+			m_currentAngle += Core.M120C_GetCurrentTwistStep( m_core );
+		}
+
+		private void MouseMove( object sender, MouseEventArgs e )
+		{
+			// Make sure we have the focus.
+			m_frame.DrawSurface.Select();
+
+			// Are we starting a drag?
+			// NOTE: The mousedown checks make sure we had a mouse down call and fixes a problem I was seeing
+			//		 where the view would reset when you loaded in a log file.
+			if( !m_dragging && e.Button != MouseButtons.None &&
+				-1 != m_mouseDownX && -1 != m_mouseDownY &&
+				((Math.Abs( e.X - m_mouseDownX ) > SystemInformation.DragSize.Width / 2) ||
+				(Math.Abs( e.Y - m_mouseDownY ) > SystemInformation.DragSize.Height / 2)) )
+			{
+				StartDrag();
+
+				// Fake the original mouse position so we will get some drag motion immediately.
+				m_mouseLastX = m_mouseDownX;
+				m_mouseLastY = m_mouseDownY;
+			}
+
+			// Are we dragging?
+			if( m_dragging )
+				PerformDrag( e.X, e.Y, e.Button );
+
+			m_mouseLastX = e.X;
+			m_mouseLastY = e.Y;
+
+			// We don't need to continue past here if we are animating.
+			if( m_animating )
+				return;
+
+			Redraw( true );
+		}
+
+		private void StartDrag()
+		{
+			m_dragging = true;
+			m_frame.DrawSurface.Capture = true;
+		}
+
+		private void PerformDrag( int x, int y, MouseButtons btn )
+		{
+			Rectangle rect = m_frame.DrawSurface.ClientRectangle;
+			Core.M120C_PerformDrag( m_core, x - m_mouseLastX, y - m_mouseLastY, rect.Width, rect.Height,
+				btn == MouseButtons.Left ? 1 : 0, btn == MouseButtons.Right ? 1 : 0 );
+		}
+
+		private void FinishDrag()
+		{
+			m_frame.DrawSurface.Capture = false;
+			m_dragging = false;
+		}
+
+		private void MouseDown( object sender, MouseEventArgs e )
+		{
+			m_mouseDownX = e.X;
+			m_mouseDownY = e.Y;
+		}
+
+		private void MouseUp( object sender, MouseEventArgs e )
+		{
+			// NOTE: The mousedown checks make sure we had a mouse down call and fixes a problem I was seeing
+			//		 where where unintended sticker clicks could happen when loading a log file.
+			if( -1 == m_mouseDownX || -1 == m_mouseDownY )
+				return;
+
+			m_mouseDownX = m_mouseDownY = -1;
+
+			// Figure out if we were dragging, and if the drag is done.
+			if( m_dragging )
+			{
+				if( Control.MouseButtons == MouseButtons.None )
+					FinishDrag();
+				return;
+			}
+
+			if( m_animating )
+				return;
+
+			// Past here, the mouse-up represents a click.
+
+			if( e.Button == MouseButtons.Left || e.Button == MouseButtons.Right )
+			{
+				Rectangle rect = m_frame.DrawSurface.ClientRectangle;
+				if( 0 != Core.M120C_Click( m_core, rect.Width, rect.Height, e.X, e.Y, e.Button == MouseButtons.Left ? 1 : 0,
+					ShiftDown() ? 1 : 0, CtrlDown() ? 1 : 0, AltDown() ? 1 : 0 ) )
+				{
+					RotationStarted();
+				}
+			}
+		}
+
+		private void KeyDown( object sender, KeyEventArgs e )
+		{
+			if( m_solving && e.KeyCode == Keys.Escape )
+				m_solving = false;
+		}
+
+		public void SetParameter( CubeParameter param, int value )
+		{
+			Core.M120C_SetParameter( m_core, (int)param, value );
+			Redraw( true );
+		}
+
+		public void SetupStickerRatios( double r1, double r2, double r3 )
+		{
+			Core.M120C_SetupStickerRatios( m_core, r1, r2, r3 );
+			Redraw( true );
+		}
+
+		public bool EnableRedraw
+		{
+			get { return m_enableRedraw; }
+			set
+			{
+				m_enableRedraw = value;
+				if( value )
+					Redraw( false );
+			}
+		}
+
+		public void EnableFace( int face, bool enable )
+		{
+			Core.M120C_EnableFace( m_core, face, enable ? 1 : 0 );
+			Redraw( true );
+		}
+
+		public void ColorFace( int face, Color c )
+		{
+			// Face -1 sets the background color.
+			Core.M120C_ColorFace( m_core, face, c.R, c.G, c.B, c.A );
+		}
+
+		public void CycleStickerAccent( int colors )
+		{
+			Core.M120C_CycleStickerAccent( m_core, colors );
+			Redraw( true );
+		}
+
+		public void Save( bool saveas )
+		{
+			if( m_animating )
+				return;
+
+			string fileName = GetSaveFileName( saveas );
+			if( "" == fileName )
+				return;
+
+			Core.M120C_Save( m_core, fileName );
+		}
+
+		public void Load()
+		{
+			if( m_animating )
+				return;
+
+			Core.M120C_Load( m_core, GetLoadFileName() );
+			Redraw( true );
+		}
+
+		private const string Filter = "MagicCube5D log files (*.log)|*.log|All files (*.*)|*.*";
+
+		private string GetSaveFileName( bool forcePrompt )
+		{
+			if( 0 == m_filename.Length || forcePrompt )
+			{
+				SaveFileDialog dlg = new SaveFileDialog();
+				dlg.AddExtension = true;
+				dlg.OverwritePrompt = true;
+				dlg.Filter = Filter;
+				if( DialogResult.OK != dlg.ShowDialog() )
+					return "";
+				m_filename = dlg.FileName;
+			}
+
+			return m_filename;
+		}
+
+		private string GetLoadFileName()
+		{
+			OpenFileDialog dlg = new OpenFileDialog();
+			dlg.CheckFileExists = true;
+			dlg.Filter = Filter;
+			if( DialogResult.OK != dlg.ShowDialog() )
+				return "";
+			m_filename = dlg.FileName;
+			return dlg.FileName;
+		}
+
+		public void Scramble( int number )
+		{
+			if( m_animating )
+				return;
+
+			Core.M120C_Scramble( m_core, number );
+			Redraw( true );
+		}
+
+		public void Solve()
+		{
+			if( m_animating )
+				return;
+
+			// Start the first undo.
+			if( 0 != Core.M120C_StartUndo( m_core ) )
+			{
+				m_solving = true;
+				RotationStarted();
+			}
+
+			// Clicking the solve button means the puzzle shouldn't be counted as scrambled.
+			Core.M120C_MarkUnscrambled( m_core );
+		}
+
+		public void Undo()
+		{
+			if( m_animating )
+				return;
+
+			if( 0 != Core.M120C_StartUndo( m_core ) )
+				RotationStarted();
+		}
+
+		public void Redo()
+		{
+			if( m_animating )
+				return;
+
+			if( 0 != Core.M120C_StartRedo( m_core ) )
+				RotationStarted();
+		}
+
+		public void ResetState()
+		{
+			if( m_animating )
+				return;
+
+			Core.M120C_ResetState( m_core );
+		}
+
+		public void ResetView()
+		{
+			if( m_animating )
+				return;
+
+			Core.M120C_ResetView( m_core );
+			DoRender();
+		}
+
+		public void KeyUp()
+		{
+			// Reset click handling.
+			if( !ShiftDown() || !CtrlDown() )
+			{
+				Core.M120C_ClearStickersToHighlight( m_core );
+				Redraw( true );
+			}
+		}
+
+		// Called after the core has started a rotation (was internalRotate).
+		private void RotationStarted()
+		{
+			m_currentAngle = 0;
+			m_animating = true;
+			m_timer.Enabled = true;
+		}
+
+		// Show a congratulatory solved message.
+		private void ShowSolvedMessage()
+		{
+			string text = "You are a true permutation puzzle master and now one with the universe.\n\n" +
+				"Be sure to send your logfile to roice@gravitation3d.com\n" +
+				"to get your name listed in the Magic120Cell Hall of Insanity!";
+			string caption = "Magic120Cell Unraveled!";
+			MessageBox.Show( text, caption, MessageBoxButtons.OK, MessageBoxIcon.Exclamation );
+		}
+
+		private void Redraw( bool force )
+		{
+			if( force || m_enableRedraw )
+				m_frame.DrawSurface.Invalidate();
+		}
+
+		private void DoRender()
+		{
+			using( Graphics g = Graphics.FromHwnd( m_frame.DrawSurface.Handle ) )
+				DoRender( g );
+		}
+
+		private void DoRender( Graphics g )
+		{
+			Core.M120C_RenderScene( m_core, m_frame.DrawSurface.ClientRectangle.Width, m_frame.DrawSurface.ClientRectangle.Height );
+
+			IntPtr hdc = g.GetHdc();
+			Core.SwapBuffers( hdc );
+			g.ReleaseHdc( hdc );
+		}
+
+		private static bool ShiftDown()
+		{
+			return (Control.ModifierKeys & Keys.Shift) == Keys.Shift;
+		}
+
+		private static bool CtrlDown()
+		{
+			return (Control.ModifierKeys & Keys.Control) == Keys.Control;
+		}
+
+		private static bool AltDown()
+		{
+			return (Control.ModifierKeys & Keys.Alt) == Keys.Alt;
+		}
+
+		// The native core's C API (coreApi.cpp).
+		private static class Core
+		{
+			private const string Dll = "Magic120CellCore.dll";
+			private const CallingConvention Cdecl = CallingConvention.Cdecl;
+
+			[DllImport( "gdi32.dll" )]
+			public static extern bool SwapBuffers( IntPtr hdc );
+
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern IntPtr M120C_Create();
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_Destroy( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_InitGL( IntPtr hwnd );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_RenderScene( IntPtr core, int width, int height );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern double M120C_GetCurrentTwistStep( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern double M120C_GetCurrentTwistEndAngle( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_IterateRotate( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_FinishRotate( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern int M120C_CheckSolved( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern int M120C_StartUndo( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern int M120C_StartRedo( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_PerformDrag( IntPtr core, int dx, int dy, int width, int height, int leftButton, int rightButton );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern int M120C_Click( IntPtr core, int width, int height, int x, int y, int left, int shift, int ctrl, int alt );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_SetParameter( IntPtr core, int param, int value );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_SetupStickerRatios( IntPtr core, double r1, double r2, double r3 );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_EnableFace( IntPtr core, int face, int enable );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_ColorFace( IntPtr core, int face, int red, int green, int blue, int alpha );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_CycleStickerAccent( IntPtr core, int colors );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_Save( IntPtr core, [MarshalAs( UnmanagedType.LPWStr )] string fileName );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_Load( IntPtr core, [MarshalAs( UnmanagedType.LPWStr )] string fileName );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_Scramble( IntPtr core, int number );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_MarkUnscrambled( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_ResetState( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_ResetView( IntPtr core );
+			[DllImport( Dll, CallingConvention = Cdecl )] public static extern void M120C_ClearStickersToHighlight( IntPtr core );
+		}
+	}
+}
