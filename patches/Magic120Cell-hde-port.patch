diff --git a/Magic120Cell/coreApi.cpp b/Magic120Cell/coreApi.cpp
new file mode 100644
index 0000000..f96fe00
--- /dev/null
+++ b/Magic120Cell/coreApi.cpp
@@ -0,0 +1,376 @@
+// A plain C API over the puzzle core, called by the C# GUI (CubeFrame.cs) via P/Invoke.
+// This replaces the C++/CLI CubeFrame class, so the core builds as a native DLL.
+
+#include <stdafx.h>
+
+#include "gl/glInit.h"
+#include "helper.h"
+#include "workFiles/magic120Cell.h"
+
+#define M120C_API extern "C" __declspec(dllexport)
+
+struct SCore
+{
+	CPuzzle * m_puzzle;
+	CRenderer * m_renderer;
+};
+
+M120C_API SCore *
+M120C_Create()
+{
+	SCore * core = new SCore();
+	core->m_puzzle = new CMagic120Cell();
+	core->m_renderer = new CRenderer( core->m_puzzle );
+	return core;
+}
+
+M120C_API void
+M120C_Destroy( SCore * core )
+{
+	delete core->m_puzzle;
+	delete core->m_renderer;
+	delete core;
+}
+
+M120C_API void
+M120C_InitGL( HWND hwnd )
+{
+	CGlInit glInit;
+	glInit.initializeGL( hwnd );
+}
+
+M120C_API void
+M120C_RenderScene( SCore * core, int width, int height )
+{
+	core->m_renderer->renderScene( width, height );
+}
+
+M120C_API double
+M120C_GetCurrentTwistStep( SCore * core )
+{
+	return core->m_puzzle->getCurrentTwistStep();
+}
+
+// The angle at which the current twist is finished, in degrees.
+M120C_API double
+M120C_GetCurrentTwistEndAngle( SCore * core )
+{
+	return rad2deg( core->m_puzzle->getCurrentTwistMagnitude() );
+}
+
+M120C_API void
+M120C_IterateRotate( SCore * core )
+{
+	core->m_puzzle->iterateRotate();
+}
+
+M120C_API void
+M120C_FinishRotate( SCore * core )
+{
+	core->m_puzzle->finishRotate();
+}
+
+// Called after a twist finishes. Returns 0 if the puzzle is not solved,
+// 1 if it is solved (beep), and 3 if a congratulatory message should be shown too.
+M120C_API int
+M120C_CheckSolved( SCore * core )
+{
+	// NOTE: Don't do solution checks after view rotations.
+	if( !core->m_puzzle->getCurrentTwist().m_viewRotation && core->m_puzzle->isSolved() )
+		return core->m_puzzle->canShowSolvedMessage() ? 3 : 1;
+	return 0;
+}
+
+// These return 0 if there is nothing to undo/redo; otherwise they start the rotation.
+M120C_API int
+M120C_StartUndo( SCore * core )
+{
+	STwist undo;
+	if( !core->m_puzzle->twistHistory().getUndoTwist( undo ) )
+		return 0;
+	core->m_puzzle->startRotate( undo );
+	return 1;
+}
+
+M120C_API int
+M120C_StartRedo( SCore * core )
+{
+	STwist redo;
+	if( !core->m_puzzle->twistHistory().getRedoTwist( redo ) )
+		return 0;
+	core->m_puzzle->startRotate( redo );
+	return 1;
+}
+
+M120C_API void
+M120C_PerformDrag( SCore * core, int dx, int dy, int width, int height, int leftButton, int rightButton )
+{
+	CRenderer * renderer = core->m_renderer;
+
+	// This is increment we moved, scaled to the window size.
+	float xIncrement = (float)dx / (float)width;
+	float yIncrement = (float)dy / (float)height;
+
+	// A measure of the magnitude of the change.
+	float magnitude = (float)( sqrt( xIncrement*xIncrement + yIncrement*yIncrement ) * 100 );
+
+	if( leftButton )
+	{
+		// The spherical coordinate radius.
+		CVector3D & view = renderer->m_viewLookfrom;
+		double radius = view.abs();
+		if( ! IS_ZERO( radius ) )
+		{
+			CVector3D & up = renderer->m_up;
+			CVector3D v1 = up.cross( view );
+			CVector3D v2 = view.cross( v1 );
+			v1.normalize();
+			v2.normalize();
+
+			view.rotateAboutAxis( v2, -xIncrement*magnitude );
+			view.rotateAboutAxis( v1, -yIncrement*magnitude );
+			up.rotateAboutAxis( v2, -xIncrement*magnitude );
+			up.rotateAboutAxis( v1, -yIncrement*magnitude );
+		}
+	}
+
+	if( rightButton )
+	{
+		// The view vector magnitude.
+		CVector3D viewVector = renderer->m_viewLookfrom - renderer->m_viewLookat;
+		double abs = viewVector.abs();
+
+		// Increment it.
+		abs += 5 * abs * yIncrement;
+		viewVector.normalize();
+		viewVector *= abs;
+
+		double smallestRadius = .02;
+		if( viewVector.abs() < smallestRadius )
+		{
+			viewVector.normalize( );
+			viewVector *= smallestRadius;
+		}
+
+		// Set the new position.
+		renderer->m_viewLookfrom = viewVector;
+	}
+}
+
+// A left or right click on the puzzle. Returns 1 if a rotation was started.
+M120C_API int
+M120C_Click( SCore * core, int width, int height, int x, int y, int left, int shift, int ctrl, int alt )
+{
+	CPuzzle * puzzle = core->m_puzzle;
+
+	if( shift && ctrl && alt )
+	{
+		puzzle->regenColors();
+		return 0;
+	}
+
+	int stickerHash = core->m_renderer->renderForPicking( width, height, x, y );
+
+	if( -1 != stickerHash )
+	{
+		// What we do depends on ctrl, shift, left/right.
+		if( shift && ctrl )
+		{
+			puzzle->highlightSticker( stickerHash, false, 0 != left );
+		}
+		else if( shift )
+		{
+			puzzle->highlightSticker( stickerHash, true, 0 != left );
+		}
+		else
+		{
+			if( ctrl )
+			{
+				int clickedCell, dummy;
+				decodeStickerHash( stickerHash, clickedCell, dummy );
+
+				STwist twist;
+				if( puzzle->calcViewTwist( clickedCell, 0 != left, twist ) )
+				{
+					puzzle->startRotate( twist );
+					return 1;
+				}
+			}
+			else
+			{
+				STwist twist( stickerHash, 0 != left );
+
+				// Detect if this twist was just the reverse of the last twist.
+				STwist temp;
+				if( puzzle->twistHistory().getUndoTwist( temp, false ) && temp == twist )
+					puzzle->twistHistory().getUndoTwist( temp );
+
+				// Don't try to twist if a 1C was clicked.
+				if( 0 != twist.m_sticker )
+				{
+					puzzle->startRotate( twist );
+					return 1;
+				}
+			}
+		}
+	}
+
+	return 0;
+}
+
+// The values of the C# CubeParameter enum.
+enum CubeParameter
+{
+	Puzzle,
+	Perspective4d,
+	CellDistance,
+	CellSize,
+	StickerSize,
+	RotationRate,
+	LogicalVisibility,
+	Symmetry,
+	DrawInvertedCells,
+	ReverseInvertedCellColor,
+	DrawWireframe,
+};
+
+M120C_API void
+M120C_SetParameter( SCore * core, int param, int value )
+{
+	CPuzzle * puzzle = core->m_puzzle;
+	CSettings & settings = puzzle->getSettings();
+	switch( param )
+	{
+	case Puzzle:
+		puzzle->setPuzzleType( (int)value );
+		break;
+	case Perspective4d:
+		settings.m_projection4Distance = 3.0 + pow( (double)value / 25, 2 );
+		break;
+	case CellDistance:
+		settings.m_cellDistance = 1.0 + (double)value / 25;
+		break;
+	case CellSize:
+		settings.m_cellSize = (double)value / 100;
+		break;
+	case StickerSize:
+		settings.m_stickerSize = (double)value / 100;
+		break;
+	case RotationRate:
+		settings.m_rotationStep = 0.1 + (double)value / 5;
+
+		// Make extremely large for disco ball mode.
+		if( (int)value == 100 )
+			settings.m_rotationStep = 200;
+		break;
+	case LogicalVisibility:
+		settings.m_logicalVisibility = (short)value;
+		break;
+	case Symmetry:
+		settings.m_symmetry = value;
+		puzzle->physicalVisibilityChanged();
+		break;
+	case DrawInvertedCells:
+		settings.m_drawInvertedCells = 1 == value ? true : false;
+		break;
+	case ReverseInvertedCellColor:
+		settings.m_reverseInvertedCellColor = 1 == value ? true : false;
+		break;
+	case DrawWireframe:
+		settings.m_drawWireframe = 1 == value ? true : false;
+		break;
+	}
+
+	puzzle->settingsChanged();
+}
+
+M120C_API void
+M120C_SetupStickerRatios( SCore * core, double r1, double r2, double r3 )
+{
+	CSettings & settings = core->m_puzzle->getSettings();
+	settings.m_r1 = r1;
+	settings.m_r2 = r2;
+	settings.m_r3 = r3;
+	core->m_puzzle->shapeChanged();
+}
+
+M120C_API void
+M120C_EnableFace( SCore * core, int face, int enable )
+{
+	core->m_puzzle->getSettings().m_visibility[face] = 0 != enable;
+	core->m_puzzle->physicalVisibilityChanged();
+}
+
+// Face -1 is the background.
+M120C_API void
+M120C_ColorFace( SCore * core, int face, int red, int green, int blue, int alpha )
+{
+	CColor color( (float)red / 255, (float)green / 255, (float)blue / 255, (float)alpha / 255 );
+	if( -1 == face )
+		core->m_renderer->setBackgroundColor( color );
+	else
+		core->m_puzzle->setColor( face, color );
+}
+
+M120C_API void
+M120C_CycleStickerAccent( SCore * core, int colors )
+{
+	CSettings & settings = core->m_puzzle->getSettings();
+	switch( colors )
+	{
+	case 1:
+		settings.m_highlight1C = !settings.m_highlight1C;
+		break;
+	case 2:
+		settings.m_highlight2C = !settings.m_highlight2C;
+		break;
+	case 3:
+		settings.m_highlight3C = !settings.m_highlight3C;
+		break;
+	case 4:
+		settings.m_highlight4C = !settings.m_highlight4C;
+		break;
+	}
+}
+
+M120C_API void
+M120C_Save( SCore * core, const wchar_t * fileName )
+{
+	core->m_puzzle->save( fileName );
+}
+
+M120C_API void
