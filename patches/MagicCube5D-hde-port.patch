+// Line-based text file I/O matching what the original System::IO code did:
+// lines are written with CRLF, and read lines may end in CRLF, LF or CR.
+class CLineReader {
+public:
+    bool open(const wchar_t* fileName) {
+        FILE* f = _wfopen(fileName, L"rb");
+        if (!f) return false;
+        char buf[4096];
+        size_t n;
+        while ((n = fread(buf, 1, sizeof(buf), f)) > 0) m_data.append(buf, n);
+        fclose(f);
+
+        // Skip a UTF-8 byte order mark, as StreamReader does.
+        if (m_data.compare(0, 3, "\xEF\xBB\xBF") == 0) m_pos = 3;
+        return true;
+    }
 
