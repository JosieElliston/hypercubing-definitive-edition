+++ b/src/MagicCubeGui/CubeFrame.cs
@@ -0,0 +1,688 @@
+namespace MagicCube5D
+{
+    using System;
+    using System.Collections.Generic;
+    using System.ComponentModel;
+    using System.Drawing;
+    using System.Runtime.InteropServices;
+    using System.Windows.Forms;
+
+    /// <summary>
+    /// Connects the GUI to the native puzzle core (MagicCube5DCore.dll).
+    /// This was the C++/CLI CubeFrame class; it moved here so no part of the program is mixed-mode.
+    /// </summary>
+    public class CubeFrame : ICube
+    {
+        // The main frame of our UI
+        private MainFrame frame;
+
+        // Additional managed component bits.
+        private IContainer components;
+        private Timer timer;
+
+        // The cube renderer.
+        private IntPtr renderer;
+        private bool enableRedraw = true;
+
+        // Whether or not we are solving.
+        private bool solving;
+
+        // Rotation stuff.
+        private double currentAngle;
+
+        // Animating?
+        private bool animating;
+
+        // Mouse moving.
+        private int mouseDownX = -1;
+        private int mouseDownY = -1;
+        private bool dragging;
+        private int mouseLastX;
+        private int mouseLastY;
+
+        // Our current slicemask;
+        private int slicemask;
+
+        // The last filename we saved or loaded.
+        private string fileName = "";
+
+        public bool EnableRedraw
+        {
+            get
+            {
+                return enableRedraw;
+            }
+            set
+            {
+                enableRedraw = value;
+                if (value)
+                {
+                    Redraw(false);
+                }
+            }
+        }
+
+        // run the application
+        public void Run()
+        {
+            frame = new MainFrame(this);
+
+            components = new Container();
+            timer = new Timer(components) { Interval = 20 };
+            timer.Tick += TimerTick;
+
+            frame.Load += FrameLoad;
+
+            frame.DrawSurface.Paint += Paint;
+            frame.DrawSurface.KeyDown += KeyDown;
+            frame.DrawSurface.KeyUp += KeyUp;
+            frame.KeyDown += SliceDown;
+            frame.KeyUp += SliceUp;
+            frame.DrawSurface.MouseDown += MouseDown;
+            frame.DrawSurface.MouseMove += MouseMove;
+            frame.DrawSurface.MouseUp += MouseUp;
+
+            renderer = Core.MC5D_Create();
+
+            UpdateSolvedInfo();
+
+            Application.Run(frame);
+
+            components.Dispose();
+            Core.MC5D_Destroy(renderer);
+        }
+
+        private void UpdateSolvedInfo()
+        {
+            var si = new int[14];
+            Core.MC5D_GetSolvedInfo(renderer, si);
+            frame.UpdateProgressPage(si[0], si[1], si[2], si[3], si[4], si[5], si[6],
+                si[7], si[8], si[9], si[10], si[11], si[12], si[13]);
+        }
+
+        private void FrameLoad(object sender, EventArgs args)
+        {
+            Core.MC5D_InitGL(frame.DrawSurface.Handle);
+        }
+
+        private void Paint(object sender, PaintEventArgs args)
+        {
+            DoRender(args.Graphics);
+        }
+
+        private void TimerTick(object sender, EventArgs e)
+        {
+            if (currentAngle + Core.MC5D_GetRotationStep(renderer) >= 90)
+            {
+                Core.MC5D_FinishRotate(renderer);
+                UpdateSolvedInfo();
+                var showMessage = false;
+
+                // Special handling if we are solving.
+                if (solving)
+                {
+                    // Start the next undo.
+                    if (Core.MC5D_StartUndo(renderer) != 0)
+                    {
+                        RotationStarted();
+                        return;
+                    }
+                    else
+                    {
+                        solving = false;
+                    }
+                }
+                else
+                {
+                    showMessage = Core.MC5D_ShowSolvedMessage(renderer) != 0;
+                }
+
+                timer.Enabled = false;
+                animating = false;
+
+                // We need to select a sticker.
+                InternalSelectSticker();
+
+                Redraw(false);
+
+                // Show a congratulatory message if they've solved it.
+                if (showMessage)
+                {
+                    ShowSolvedMessage();
+                }
+
+                return;
+            }
+
+            // Do the drawing.
+            Core.MC5D_IterationMade(renderer);
+            DoRender();
+
+            currentAngle += Core.MC5D_GetRotationStep(renderer);
+        }
+
+        private void MouseMove(object sender, MouseEventArgs e)
+        {
+            // Make sure we have the focus.
+            frame.DrawSurface.Select();
+
+            // Are we starting a drag?
+            // NOTE: The mousedown checks makes sure we had a mouse down call and fixes a problem I was seeing
+            //       where the view would reset when you loaded in a log file.
+            if (!dragging && e.Button != MouseButtons.None && -1 != mouseDownX && -1 != mouseDownY
+                && ((Math.Abs(e.X - mouseDownX) > SystemInformation.DragSize.Width / 2)
+                    || (Math.Abs(e.Y - mouseDownY) > SystemInformation.DragSize.Height / 2)))
+            {
+                StartDrag();
+
+                // Fake the original mouse position so we will get some drag motion immediately.
+                mouseLastX = mouseDownX;
+                mouseLastY = mouseDownY;
+            }
+
+            // Are we dragging?
+            if (dragging)
+            {
+                PerformDrag(e.X, e.Y, e.Button);
+            }
+
+            mouseLastX = e.X;
+            mouseLastY = e.Y;
+
+            // We don't need to continue past here if we are animating.
+            if (animating)
+            {
+                return;
+            }
+
+            // Select a sticker based on the new mouse position.
+            InternalSelectSticker();
+
+            Redraw(true);
+        }
+
+        private void StartDrag()
+        {
+            dragging = true;
+            frame.DrawSurface.Capture = true;
+        }
+
+        private void PerformDrag(int x, int y, MouseButtons btn)
+        {
+            var rect = frame.DrawSurface.ClientRectangle;
+            Core.MC5D_PerformDrag(renderer, x - mouseLastX, y - mouseLastY, rect.Width, rect.Height,
+                btn == MouseButtons.Left ? 1 : 0, btn == MouseButtons.Right ? 1 : 0);
+        }
+
+        private void FinishDrag()
+        {
+            frame.DrawSurface.Capture = false;
+            dragging = false;
+        }
+
+        private void MouseDown(object sender, MouseEventArgs e)
+        {
+            mouseDownX = e.X;
+            mouseDownY = e.Y;
+        }
+
+        private void MouseUp(object sender, MouseEventArgs e)
+        {
+            mouseDownX = mouseDownY = -1;
+
+            // Figure out if we were dragging, and if the drag is done.
+            if (dragging)
+            {
+                if (Control.MouseButtons == MouseButtons.None)
+                {
+                    FinishDrag();
+                }
+
+                return;
+            }
+
+            if (animating)
+            {
+                return;
+            }
+
+            // Past here, the mouse-up represents a click.
+
+            // Left button click.
+            if (e.Button == MouseButtons.Left)
+            {
+                if (Core.MC5D_HandleClick(renderer, CtrlDown() ? 1 : 0, slicemask == 0 ? 1 : slicemask) != 0)
+                {
+                    RotationStarted();
+                }
+            }
+        }
+
+        private void KeyDown(object sender, KeyEventArgs e)
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            // Reset click handling.
+            if (e.KeyCode == Keys.Escape)
+            {
+                Core.MC5D_ResetClickState(renderer);
+            }
+
+            // Cycle through click stickers.
+            if (e.KeyCode == Keys.Left)
+            {
+                Core.MC5D_CycleSelectedGotoSticker(renderer, 1);
+            }
+
+            if (e.KeyCode == Keys.Right)
+            {
+                Core.MC5D_CycleSelectedGotoSticker(renderer, 0);
+            }
+
+            // Shift
+            if (e.KeyCode == Keys.ShiftKey)
+            {
+                // We need to select a sticker.
+                InternalSelectSticker();
+            }
+
+            Redraw(true);
+        }
+
+        private void KeyUp(object sender, KeyEventArgs e)
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            // Shift
+            if (e.KeyCode == Keys.ShiftKey)
+            {
+                // We need to select a sticker.
+                InternalSelectSticker();
+            }
+
+            Redraw(true);
+        }
+
+        private static int SliceBit(Keys key)
+        {
+            switch (key)
+            {
+                case Keys.NumPad1: case Keys.D1: return 0x01;
+                case Keys.NumPad2: case Keys.D2: return 0x02;
+                case Keys.NumPad3: case Keys.D3: return 0x04;
+                case Keys.NumPad4: case Keys.D4: return 0x08;
+                case Keys.NumPad5: case Keys.D5: return 0x10;
+                case Keys.NumPad6: case Keys.D6: return 0x20;
+                case Keys.NumPad7: case Keys.D7: return 0x40;
+                default: return 0;
+            }
+        }
+
+        private void SliceDown(object sender, KeyEventArgs e)
+        {
+            // Update our slicemask;
+            slicemask |= SliceBit(e.KeyCode);
+        }
+
+        private void SliceUp(object sender, KeyEventArgs e)
+        {
+            // Update our slicemask;
+            slicemask &= ~SliceBit(e.KeyCode);
+        }
+
+        public void SetParameter(CubeParameter param, int value)
+        {
+            Core.MC5D_SetParameter(renderer, (int)param, value);
+            if (param == CubeParameter.Puzzle)
+            {
+                UpdateSolvedInfo();
+            }
+
+            Redraw(true);
+        }
+
+        public void CycleStickerAccent(int colors)
+        {
+            Core.MC5D_CycleStickerAccent(renderer, colors);
+            Redraw(true);
+        }
+
+        public void EnableFace(int face, bool enable)
+        {
+            Core.MC5D_EnableFace(renderer, face, enable ? 1 : 0);
+            Redraw(true);
+        }
+
+        public void ColorFace(int face, Color c)
+        {
+            // Face 10 sets the background color.
+            Core.MC5D_ColorFace(renderer, face, c.R, c.G, c.B, c.A);
+        }
+
+        public void Rotate(int a1, int a2, int face, int dummy)
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            Core.MC5D_StartRotate(renderer, a1, a2, face, slicemask == 0 ? 1 : slicemask);
+            RotationStarted();
+        }
+
+        // Called after the core has started a rotation (was internalRotate).
+        private void RotationStarted()
+        {
+            currentAngle = 0;
+            animating = true;
+            timer.Enabled = true;
+        }
+
+        // Show a congratulatory solved message.
+        private void ShowSolvedMessage()
+        {
+            var text = "Congratulations!  You have achieved ultimate super-nerd status.\n\n"
+                + "Take a few moments and space-out on the ridiculousness of what you have just accomplished, then "
+                + "send your logfile to roice@gravitation3d.com to get your name listed in the MagicCube5D Hall of Insanity.";
+            var caption = "MagicCube5D Conquered!";
+            MessageBox.Show(text, caption, MessageBoxButtons.OK, MessageBoxIcon.Exclamation);
+        }
+
+        public void Save(bool saveas)
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            var name = GetSaveFileName(saveas);
+            if (name == "")
+            {
+                return;
+            }
+
+            Core.MC5D_Save(renderer, name);
+        }
+
+        public void Load()
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            Core.MC5D_Load(renderer, GetLoadFileName());
+            UpdateSolvedInfo();
+            Redraw(true);
+        }
+
+        private const string Filter = "MagicCube5D log files (*.log)|*.log|All files (*.*)|*.*";
+
+        private string GetSaveFileName(bool forcePrompt)
+        {
+            if (fileName.Length == 0 || forcePrompt)
+            {
+                var dlg = new SaveFileDialog
+                {
+                    AddExtension = true,
+                    OverwritePrompt = true,
+                    Filter = Filter
+                };
+                if (DialogResult.OK != dlg.ShowDialog())
+                {
+                    return "";
+                }
+
+                fileName = dlg.FileName;
+            }
+
+            return fileName;
+        }
+
+        private string GetLoadFileName()
+        {
+            var dlg = new OpenFileDialog
+            {
+                CheckFileExists = true,
+                Filter = Filter
+            };
+            if (DialogResult.OK != dlg.ShowDialog())
+            {
+                return "";
+            }
+
+            fileName = dlg.FileName;
+            return dlg.FileName;
+        }
+
+        public void Scramble(int number)
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            Core.MC5D_Scramble(renderer, number);
+            UpdateSolvedInfo();
+            Redraw(true);
+        }
+
+        public void Solve()
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            // Start the first undo.
+            if (Core.MC5D_StartUndo(renderer) != 0)
+            {
+                solving = true;
+                RotationStarted();
+            }
+        }
+
+        public void Undo()
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            if (Core.MC5D_StartUndo(renderer) != 0)
+            {
+                RotationStarted();
+            }
+        }
+
+        public void Redo()
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            if (Core.MC5D_StartRedo(renderer) != 0)
+            {
+                RotationStarted();
+            }
+        }
+
+        public void Reset()
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            Core.MC5D_Reset(renderer);
+            UpdateSolvedInfo();
+        }
+
+        public void HighlightCubies(List<int> colors)
+        {
+            Core.MC5D_HighlightCubies(renderer, colors.ToArray(), colors.Count);
+        }
+
+        public string[] GetMacroNames()
+        {
+            var names = new List<string>();
+            Core.MC5D_GetMacroNames(renderer, names.Add);
+            return names.ToArray();
+        }
+
+        // XXX - make these return a bool so we are sure to stay synced with macro file.
+        //       e.g. changing a name could update the UI but not the macro file as it is now.
+        public void StartMacroRecord()
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            Core.MC5D_StartMacroRecord(renderer);
+        }
+
+        public void StopMacroRecord()
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            Core.MC5D_StopMacroRecord(renderer);
+        }
+
+        public void RenameMacro(int index, string name)
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            Core.MC5D_RenameMacro(renderer, index, name);
+        }
+
+        public void DeleteMacro(int index)
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            Core.MC5D_DeleteMacro(renderer, index);
+        }
+
+        public void ExecuteMacro(int index, bool reverse)
+        {
+            if (animating)
+            {
+                return;
+            }
+
+            Core.MC5D_ExecuteMacro(renderer, index, reverse ? 1 : 0);
+            Redraw(true);
+
+            UpdateSolvedInfo();
+
+            // Show a congratulatory message if they've solved it.
+            if (Core.MC5D_ShowSolvedMessage(renderer) != 0)
+            {
+                ShowSolvedMessage();
+            }
+        }
+
+        private void Redraw(bool force)
+        {
+            if (force || enableRedraw)
+            {
+                frame.DrawSurface.Invalidate();
+            }
+        }
+
+        private void DoRender()
+        {
+            using (var g = Graphics.FromHwnd(frame.DrawSurface.Handle))
+            {
+                DoRender(g);
+            }
+        }
+
+        private void DoRender(Graphics g)
+        {
+            Core.MC5D_RenderScene(renderer, frame.DrawSurface.ClientRectangle.Width,
+                frame.DrawSurface.ClientRectangle.Height, ShiftDown() ? 1 : 0);
+
+            var hdc = g.GetHdc();
+            Core.SwapBuffers(hdc);
+            g.ReleaseHdc(hdc);
+        }
+
+        private static bool ShiftDown()
+        {
+            return (Control.ModifierKeys & Keys.Shift) == Keys.Shift;
+        }
+
+        private static bool CtrlDown()
+        {
+            return (Control.ModifierKeys & Keys.Control) == Keys.Control;
+        }
+
+        // Helper to select a sticker.
+        private void InternalSelectSticker()
+        {
+            Core.MC5D_SelectSticker(renderer, mouseLastX, mouseLastY, ShiftDown() ? 1 : 0);
+        }
+
+        // The native core's C API (coreApi.cpp).
+        private static class Core
+        {
+            private const string Dll = "MagicCube5DCore.dll";
+
+            [UnmanagedFunctionPointer(CallingConvention.StdCall)]
+            public delegate void NameCallback([MarshalAs(UnmanagedType.LPStr)] string name);
+
+            [DllImport("gdi32.dll")]
+            public static extern bool SwapBuffers(IntPtr hdc);
+
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern IntPtr MC5D_Create();
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_Destroy(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_InitGL(IntPtr hwnd);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_GetSolvedInfo(IntPtr r, [Out] int[] info);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_RenderScene(IntPtr r, int width, int height, int shiftDown);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_IterationMade(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern double MC5D_GetRotationStep(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_FinishRotate(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern int MC5D_ShowSolvedMessage(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_StartRotate(IntPtr r, int a1, int a2, int face, int slicemask);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern int MC5D_StartUndo(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern int MC5D_StartRedo(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_PerformDrag(IntPtr r, int dx, int dy, int width, int height, int leftButton, int rightButton);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern int MC5D_HandleClick(IntPtr r, int ctrlDown, int slicemask);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_ResetClickState(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_CycleSelectedGotoSticker(IntPtr r, int left);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_SelectSticker(IntPtr r, int x, int y, int shiftDown);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_SetParameter(IntPtr r, int param, int value);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_CycleStickerAccent(IntPtr r, int colors);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_EnableFace(IntPtr r, int face, int enable);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_ColorFace(IntPtr r, int face, int red, int green, int blue, int alpha);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_Save(IntPtr r, [MarshalAs(UnmanagedType.LPWStr)] string fileName);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_Load(IntPtr r, [MarshalAs(UnmanagedType.LPWStr)] string fileName);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_Scramble(IntPtr r, int number);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_Reset(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_HighlightCubies(IntPtr r, int[] colors, int count);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_GetMacroNames(IntPtr r, NameCallback callback);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_StartMacroRecord(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_StopMacroRecord(IntPtr r);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_RenameMacro(IntPtr r, int index, [MarshalAs(UnmanagedType.LPStr)] string name);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_DeleteMacro(IntPtr r, int index);
+            [DllImport(Dll, CallingConvention = CallingConvention.Cdecl)] public static extern void MC5D_ExecuteMacro(IntPtr r, int index, int reverse);
+        }
+    }
+}
