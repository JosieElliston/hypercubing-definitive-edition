+}
+
+// Calls back once per macro name.
+MC5D_API void MC5D_GetMacroNames(CRenderer* r, void(__stdcall* callback)(const char*)) {
+    std::vector<std::string> macroNames;
+    r->m_cube.getMacroNames(macroNames);
+    for (uint i = 0; i < macroNames.size(); i++) callback(macroNames[i].c_str());
+}
+
+MC5D_API void MC5D_StartMacroRecord(CRenderer* r) { r->m_cube.startMacroRecord(); }
+
+MC5D_API void MC5D_StopMacroRecord(CRenderer* r) { r->m_cube.stopMacroRecord(); }
+
+MC5D_API void MC5D_RenameMacro(CRenderer* r, int index, const char* name) {
+    r->m_cube.renameMacro(index, name);
+}
+
+MC5D_API void MC5D_DeleteMacro(CRenderer* r, int index) { r->m_cube.deleteMacro(index); }
+
+MC5D_API void MC5D_ExecuteMacro(CRenderer* r, int index, int reverse) {
+    r->m_cube.executeMacro(index, reverse);
+}
