diff --git a/src/MagicCube5D/coreApi.cpp b/src/MagicCube5D/coreApi.cpp
new file mode 100644
index 0000000..29b227c
--- /dev/null
+++ b/src/MagicCube5D/coreApi.cpp
@@ -0,0 +1,284 @@
+// A plain C API over the puzzle core, called by the C# GUI (CubeFrame.cs) via P/Invoke.
+// This replaces the C++/CLI CubeFrame class, so the core builds as a native DLL.
+
+#include <stdafx.h>
+
+#include "workFiles/glInit.h"
+#include "workFiles/helper.h"
+#include "workFiles/renderer.h"
+#include "workFiles/selector.h"
+
+#define MC5D_API extern "C" __declspec(dllexport)
+
+MC5D_API CRenderer* MC5D_Create() { return new CRenderer(); }
+
+MC5D_API void MC5D_Destroy(CRenderer* r) { delete r; }
+
+MC5D_API void MC5D_InitGL(HWND hwnd) {
+    CGlInit glInit;
+    glInit.initializeGL(hwnd);
+}
+
+// Fills the 14 values MainFrame.UpdateProgressPage takes.
+MC5D_API void MC5D_GetSolvedInfo(CRenderer* r, int* info) {
+    SSolvedInfo si = r->m_cube.updateSolvedInfo();
+    int values[14] = {si.s0, si.n0, si.s1, si.n1, si.s2, si.n2, si.s3,
+                      si.n3, si.s4, si.n4, si.s5, si.n5, si.ss, si.ns};
+    for (int i = 0; i < 14; i++) info[i] = values[i];
+}
+
+MC5D_API void MC5D_RenderScene(CRenderer* r, int width, int height, int shiftDown) {
+    r->m_cube.m_settings.m_showAllCubieStickers = shiftDown;
+    r->renderScene(width, height);
+}
+
+MC5D_API void MC5D_IterationMade(CRenderer* r) { r->iterationMade(false); }
+
+MC5D_API double MC5D_GetRotationStep(CRenderer* r) {
+    return r->m_cube.m_settings.m_rotationStep;
+}
+
+MC5D_API void MC5D_FinishRotate(CRenderer* r) { r->m_cube.finishRotate(); }
+
+MC5D_API int MC5D_ShowSolvedMessage(CRenderer* r) {
+    return r->m_cube.showSolvedMessage();
+}
+
+MC5D_API void MC5D_StartRotate(CRenderer* r, int a1, int a2, int face, int slicemask) {
+    STwist twist;
+    twist.m_rotationAxis1 = a1;
+    twist.m_rotationAxis2 = a2;
+    twist.m_rotationFace = face;
+    twist.m_slicemask = slicemask;
+    r->m_cube.startRotate(twist);
+}
+
+// These return false if there is nothing to undo/redo; otherwise they start the rotation.
+MC5D_API int MC5D_StartUndo(CRenderer* r) {
+    STwist undo;
+    if (!r->m_cube.getUndoParams(undo)) return false;
+    r->m_cube.startRotate(undo);
+    return true;
+}
+
+MC5D_API int MC5D_StartRedo(CRenderer* r) {
+    STwist redo;
+    if (!r->m_cube.getRedoParams(redo)) return false;
+    r->m_cube.startRotate(redo);
+    return true;
+}
+
+MC5D_API void MC5D_PerformDrag(CRenderer* r, int dx, int dy, int width, int height,
+                               int leftButton, int rightButton) {
+
+    // This is increment we moved, scaled to the window size.
+    float xIncrement = (float)dx / (float)width;
+    float yIncrement = (float)dy / (float)height;
+
+    // A measure of the magnitude of the change.
+    float magnitude =
+            (float)(sqrt(xIncrement * xIncrement + yIncrement * yIncrement) * 100);
+
+    if (leftButton) {
+
+        // The spherical coordinate radius.
+        CVector3D viewVector = r->m_viewLookfrom - r->m_viewLookat;
+        double radius = viewVector.abs();
+        if (!IS_ZERO(radius)) {
+
+            // The spherical coordinate angles.
+            double theta =
+                    atan2(viewVector.m_components[1], viewVector.m_components[0]);
+            double phi = acos(viewVector.m_components[2] / radius);
+
+            // Increment the angles.
+            theta -= magnitude * xIncrement;
+            phi -= magnitude * yIncrement;
+
+            // Check the bounds.
+            // So we don't have to worry about the upVector, don't allow these to be
+            // exactly 0 or Pi.
+            if (phi <= 0) phi = 0.0000001;
+            if (phi >= CONSTANT_PI) phi = CONSTANT_PI - 0.0000001;
+
+            // Calculate the new position.
+            r->m_viewLookfrom.m_components[0] =
+                    r->m_viewLookat.m_components[0] + radius * sin(phi) * cos(theta);
+            r->m_viewLookfrom.m_components[1] =
+                    r->m_viewLookat.m_components[1] + radius * sin(phi) * sin(theta);
+            r->m_viewLookfrom.m_components[2] =
+                    r->m_viewLookat.m_components[2] + radius * cos(phi);
+        }
+    }
+
+    if (rightButton) {
+
+        // The view vector magnitude.
+        CVector3D viewVector = r->m_viewLookfrom - r->m_viewLookat;
+        double abs = viewVector.abs();
+
+        // Increment it.
+        abs += 5 * abs * yIncrement;
+        viewVector.normalize();
+        viewVector *= abs;
+
+        double smallestRadius = .02;
+        if (viewVector.abs() < smallestRadius) {
+            viewVector.normalize();
+            viewVector *= smallestRadius;
+        }
+
+        // Set the new position.
+        r->m_viewLookfrom = viewVector;
+    }
+}
+
+// A left click. Returns true if a rotation was started.
+MC5D_API int MC5D_HandleClick(CRenderer* r, int ctrlDown, int slicemask) {
+    if (r->m_cube.m_clickState == CCube5D::READY_FOR_FIRST)
+        return r->m_cube.handleFirstClick(ctrlDown);
+    else
+        return r->m_cube.handleSecondClick(ctrlDown, slicemask);
+}
+
+MC5D_API void MC5D_ResetClickState(CRenderer* r) { r->m_cube.resetClickState(); }
+
+MC5D_API void MC5D_CycleSelectedGotoSticker(CRenderer* r, int left) {
+    r->m_cube.cycleSelectedGotoSticker(left);
+}
+
+MC5D_API void MC5D_SelectSticker(CRenderer* r, int x, int y, int shiftDown) {
+    CVector3D linep1, linep2;
+    CSelector::unProjectMousePoint(x, y, linep1, linep2);
+    r->m_cube.selectSticker(linep1, linep2, shiftDown);
+}
+
+// The values of the C# CubeParameter enum.
+enum CubeParameter {
+    Puzzle,
+    Perspective5d,
+    Perspective4d,
+    FaceSeparation,
+    StickerSeparation,
+    StickerSize,
+    RotationRate,
+    StereoMode,
+    StereoSeparation
+};
+
+MC5D_API void MC5D_SetParameter(CRenderer* r, int param, int value) {
+    switch (param) {
+        case Puzzle:
+            r->m_cube.setPuzzleType((int)value);
+            break;
+        case Perspective5d:
+            r->m_cube.m_settings.m_projection5Distance = (double)value;
+            break;
+        case Perspective4d:
+            r->m_cube.m_settings.m_projection4Distance = (double)value;
+            break;
+        case FaceSeparation:
+            r->m_cube.m_settings.m_faceOffset = (double)value / 5;
+            break;
+        case StickerSeparation:
+            r->m_cube.m_settings.m_stickerOffset = (double)value / 10;
+            break;
+        case StickerSize:
+            r->m_cube.m_settings.m_stickerSize = (double)value / 25;
+            break;
+        case RotationRate:
+            r->m_cube.m_settings.m_rotationStep = 0.1 + (double)value / 10;
+            break;
+        case StereoMode: {
+            r->m_cube.m_settings.m_stereoMode = (EStereoMode)value;
+
+            // Alter the viewing distance depending on the mode.
+            CVector3D viewVector = r->m_viewLookfrom;
+            viewVector.normalize();
+            if (r->m_cube.m_settings.m_stereoMode == STEREO_CROSS_EYED)
+                viewVector *= 170;
+            else
+                viewVector *= 85;
+            r->m_viewLookfrom = viewVector;
+
+            break;
+        }
+        case StereoSeparation:
+            r->m_cube.m_settings.m_stereoSeparation = (double)value / 20;
+            break;
+    }
+}
+
+MC5D_API void MC5D_CycleStickerAccent(CRenderer* r, int colors) {
+    CSettings& s = r->m_cube.m_settings;
+    switch (colors) {
+        case 1:
+            s.cycleAccentSetting(s.m_accent1Colored);
+            break;
+        case 2:
+            s.cycleAccentSetting(s.m_accent2Colored);
+            break;
+        case 3:
+            s.cycleAccentSetting(s.m_accent3Colored);
+            break;
+        case 4:
+            s.cycleAccentSetting(s.m_accent4Colored);
+            break;
+        case 5:
+            s.cycleAccentSetting(s.m_accent5Colored);
+            break;
+    }
+}
+
+MC5D_API void MC5D_EnableFace(CRenderer* r, int face, int enable) {
+    r->m_cube.setFaceVisible(face, enable);
+}
+
+// Face 10 is the background.
+MC5D_API void MC5D_ColorFace(CRenderer* r, int face, int red, int green, int blue,
+                             int alpha) {
+    CColor color((float)red / 255, (float)green / 255, (float)blue / 255,
+                 (float)alpha / 255);
+    if (face == 10)
+        r->setBackgroundColor(color);
+    else
+        r->m_cube.setFaceColor(face, color);
+}
+
+MC5D_API void MC5D_Save(CRenderer* r, const wchar_t* fileName) {
+    r->m_cube.save(fileName);
+}
+
+MC5D_API void MC5D_Load(CRenderer* r, const wchar_t* fileName) {
+    r->m_cube.load(fileName);
+}
+
+MC5D_API void MC5D_Scramble(CRenderer* r, int number) { r->m_cube.scramble(number); }
+
+MC5D_API void MC5D_Reset(CRenderer* r) { r->m_cube.reset(); }
+
+MC5D_API void MC5D_HighlightCubies(CRenderer* r, const int* colors, int count) {
+    std::vector<int> tempColors(colors, colors + count);
