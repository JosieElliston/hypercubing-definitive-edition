+	// Run AppKit dialogs on the first thread, outside GLFW's event callbacks.
+	// Starting Swing here would take over the Cocoa event loop from GLFW.
+	private def showDialog(mode: String)(onResult: String => Unit): Unit = {
+		if (dialogOpen) return
+		dialogOpen = true
+		Gdx.input.setInputProcessor(new InputAdapter {})
+		Gdx.app.postRunnable(() => {
+			try {
+				val result = runDialog(mode, defaultDir.toAbsolutePath.toString, "")
+				if (result != null) onResult(result)
+			} catch {
+				case NonFatal(error) =>
+					error.printStackTrace()
+					runDialog("error", "", error.toString)
+			} finally {
+				dialogOpen = false
+				Gdx.input.setInputProcessor(defaultInputProcessor)
+			}
+		})
+	}
+
